# OAuth/Discord連携APIを動かすバックエンドの公開origin (HTTPS, パスなし)
APP_BASE_URL=https://your-auth-backend.example

# 公開ログインサイトのURL。Discord側のOAuth redirectとは別に使用する。
PUBLIC_SITE_URL=https://discord.yydassai.f5.si

# Discord Developer Portal > OAuth2 / Botから取得する値
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1550163473982300392

# Minecraftプラグインのconfig.ymlにも同じ値を設定する。32文字以上のランダム値を推奨。
PLUGIN_API_KEY=

# WebDev Managed DatabaseではプラットフォームがDATABASE_URLを設定する。
# 独自ホストの場合のみ、MySQL互換DSNを設定する。
# DATABASE_URL=mysql://user:password@host:3306/database

PORT=3000
NODE_ENV=development
